# CDN 加速配置
# 复制此文件为 .env 并填入真实值，.env 已被 gitignore

# CDN 基础 URL（构建时注入 HTML，决定静态资源从哪里加载）
CDN_BASE=https://1833788059.cdn.123clouddisk.com/1833788059/direct/projects/pico-hid-mapper-doc

# WebDAV 连接信息（用于上传资源到 CDN）
WEBDAV_URL=https://webdav.123pan.cn/webdav
WEBDAV_USER=your-username
WEBDAV_PASS=your-password
